<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>EnterpriseBIM.EnterpriseInstaller</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <StagingDir Condition="'$(StagingDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\</StagingDir>
    <DefineConstants>StagingDir=$(StagingDir)</DefineConstants>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>
</Project>
